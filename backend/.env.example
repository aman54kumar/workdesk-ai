# Copy to .env and adjust for your environment.
# Do not commit .env (contains deployment-specific URLs).

SQLITE_DB_PATH=./workdesk_cache.db
OLLAMA_BASE_URL=http://localhost:11434
# Comma-separated browser origins (Angular UI + Outlook add-in dev server)
CORS_ORIGINS=http://localhost:4200,https://localhost:3000
CACHE_TTL_HOURS=24
OLLAMA_MODEL_DEFAULT=gemma4:latest
OLLAMA_MODEL_CODE=codellama:7b
OLLAMA_MODEL_QUALITY=gemma4:latest
OLLAMA_ALLOWED_MODEL_OVERRIDES=gemma3:4b,gemma4:latest,codellama:7b,llava:7b

# Bootstrap org LLM settings (seeded to DB on first start; admin console is source of truth after)
ALLOW_USER_CLOUD=false
ORG_DISPLAY_NAME=Adit Microsys Pvt. Ltd.

# Cloud model list refresh (optional — admin UI can also store keys in DB)
# When set, provider model lists are fetched on startup if older than CLOUD_PRESET_REFRESH_DAYS
CLOUD_PRESET_REFRESH_DAYS=30
# CLOUD_MODEL_REFRESH_OPENAI_KEY=
# CLOUD_MODEL_REFRESH_ANTHROPIC_KEY=
# CLOUD_MODEL_REFRESH_GOOGLE_KEY=

# Admin (change before deploying)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE_MINUTES=480

# Production example (uncomment and edit on the server):
# OLLAMA_BASE_URL=http://<OLLAMA_HOST_IP>:11434
# CORS_ORIGINS=http://<WORKDESK_SERVER_IP>,http://<WORKDESK_SERVER_IP>:80
